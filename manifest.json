{
  "manifest_version": 3,
  "name": "X回复辅助",
  "version": "1.0.0",
  "description": "帮助识别常互动的人，了解关注关系。",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["passive.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["returns.js", "relationships.js", "marker.js"], "css": ["marker.css"], "run_at": "document_start" }
  ],
  "options_page": "options.html",
  "action": { "default_title": "X回复辅助 · 设置" },
  "minimum_chrome_version": "111"
}
